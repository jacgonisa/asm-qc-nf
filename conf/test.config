/*
 * Minimal test profile — uses tiny synthetic FASTA inputs.
 * Run: nextflow run main.nf -profile test,singularity
 */

params {
    input         = "${projectDir}/assets/test_samplesheet.csv"
    outdir        = 'test_results'

    // Disable slow tools for CI
    run_lai       = false
    run_flagger   = false
    run_nucfreq   = false

    // Reduce resources
    max_cpus      = 4
    max_memory    = '8.GB'
    max_time      = '1.h'
}
