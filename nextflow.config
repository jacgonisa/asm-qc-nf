/*
 * asm-qc-nf  —  HiFi assembly + QC pipeline
 * Modular: start from reads OR from an existing FASTA.
 */

nextflow.enable.dsl = 2

params {
    // ── Input ─────────────────────────────────────────────────────────────────
    input            = null          // path to samplesheet CSV
    outdir           = 'results'

    // ── Module toggles ────────────────────────────────────────────────────────
    run_assembly     = true          // hifiasm + ragtag (skipped if assembly_fasta given)
    run_compleasm    = true
    run_quast        = true
    run_merqury      = true
    run_lai          = true
    run_kplexity     = true
    run_flagger      = true
    run_nucfreq      = true
    run_nchart       = true

    // ── hifiasm ───────────────────────────────────────────────────────────────
    hifiasm_extra    = ''            // extra CLI args passed verbatim

    // ── RagTag ────────────────────────────────────────────────────────────────
    ragtag_min_len   = 1000000       // min scaffold length to keep (chr filter)

    // ── compleasm ─────────────────────────────────────────────────────────────
    busco_lineage    = 'embryophyta_odb10'

    // ── kplexity ──────────────────────────────────────────────────────────────
    kplexity_bin     = null          // required: path to Kplex binary
    kplexity_k       = '5:151:1'
    kplexity_h       = '1:10000000'

    // ── LAI ───────────────────────────────────────────────────────────────────
    ltr_retriever    = null          // required: path to LTR_retriever script
    genometools_bin  = 'gt'          // gt binary (must be in PATH or full path)

    // ── Nchart ────────────────────────────────────────────────────────────────
    fastalengths_bin = null          // required: path to fastalengths binary
    nchart_script    = null          // required: path to Nchart_script.R

    // ── Resources ─────────────────────────────────────────────────────────────
    max_cpus         = 32
    max_memory       = '128.GB'
    max_time         = '72.h'

    // ── Nextflow boilerplate ──────────────────────────────────────────────────
    validate_params  = true
    monochrome_logs  = false
    version          = false
}

// ── Profiles ─────────────────────────────────────────────────────────────────
profiles {
    singularity {
        singularity.enabled    = true
        singularity.autoMounts = true
        docker.enabled         = false
    }
    docker {
        docker.enabled         = true
        singularity.enabled    = false
    }
    conda {
        conda.enabled          = true
        singularity.enabled    = false
        docker.enabled         = false
    }
    local {
        process.executor       = 'local'
    }
    slurm {
        process.executor       = 'slurm'
        process.queue          = 'normal'
    }
    test {
        includeConfig 'conf/test.config'
    }
}

// ── Load resource config ──────────────────────────────────────────────────────
includeConfig 'conf/base.config'

// ── Manifest ─────────────────────────────────────────────────────────────────
manifest {
    name            = 'asm-qc-nf'
    description     = 'HiFi genome assembly and quality-control pipeline'
    author          = 'jacgonisa'
    version         = '0.1.0'
    nextflowVersion = '>=23.04.0'
    mainScript      = 'main.nf'
}

// ── Execution report ─────────────────────────────────────────────────────────
def trace_timestamp = new java.util.Date().format('yyyy-MM-dd_HH-mm-ss')
timeline { enabled = true; file = "${params.outdir}/pipeline_info/timeline_${trace_timestamp}.html" }
report   { enabled = true; file = "${params.outdir}/pipeline_info/report_${trace_timestamp}.html"   }
trace    { enabled = true; file = "${params.outdir}/pipeline_info/trace_${trace_timestamp}.txt"     }
dag      { enabled = true; file = "${params.outdir}/pipeline_info/dag_${trace_timestamp}.svg"       }
